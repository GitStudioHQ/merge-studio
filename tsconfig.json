{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "vscode"
    ],
    "paths": {
      "@gitstudio/engine/*": [
        "./vendor/gitstudio/engine/src/*"
      ],
      "@gitstudio/git-service/*": [
        "./vendor/gitstudio/git-service/src/*"
      ],
      "@gitstudio/host-bridge/*": [
        "./vendor/gitstudio/host-bridge/src/*"
      ],
      "@gitstudio/webview-ui/*": [
        "./vendor/gitstudio/webview-ui/src/*"
      ],
      "@gitstudio/merge-vscode/*": [
        "./vendor/gitstudio/merge-vscode/src/*"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
